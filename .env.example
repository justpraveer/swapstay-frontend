# ---------------------------------------------------------------------------
# SwapStay frontend environment
# Copy to .env.local and fill in. Never commit real keys.
# ---------------------------------------------------------------------------

# URL of the backend (the hackerwrath3.0 Next.js app). Used by the /api rewrite
# so the browser never makes a cross-origin request.
# Local backend:  http://localhost:3001
# Deployed:       https://your-backend.vercel.app
BACKEND_URL=http://localhost:3001

# Leave as /api to use the rewrite above. Set an absolute URL only if the
# backend enables CORS for this origin.
NEXT_PUBLIC_API_BASE_URL=/api

# Supabase project used for authentication. Must be the same project the
# backend validates tokens against.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public storage bucket holding property photos (paths returned by the API are
# turned into public URLs). Optional.
NEXT_PUBLIC_SUPABASE_PHOTO_BUCKET=property-photos

# Storage bucket for member verification documents. Optional.
NEXT_PUBLIC_SUPABASE_VERIFICATION_BUCKET=verification

# Private bucket for property ownership/lease evidence and code photos. Optional.
NEXT_PUBLIC_SUPABASE_PROPERTY_VERIFICATION_BUCKET=property-verification

# Private bucket for short listing walkthrough videos. Optional.
NEXT_PUBLIC_SUPABASE_VIDEO_BUCKET=property-videos

# Demo mode shows sample listings/bookings without a backend or Supabase.
# Toggle at runtime from the sign-in page; this flag only sets the default.
NEXT_PUBLIC_DEMO_MODE=false
